{
  "name": "nukis-colorful-adventure",
  "version": "0.0.0",
  "description": "Nuki's Colorful Adventure",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "npm@12.2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --type-aware && eslint .",
    "lint:fix": "oxlint --type-aware --fix && eslint . --fix",
    "lint:markdown": "markdownlint \"**/*.md\"",
    "lint:markdown:fix": "markdownlint --fix \"**/*.md\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=moderate",
    "check": "npm run typecheck && npm test && npm run format:check && npm run lint && npm run lint:markdown && npm run audit",
    "check:push": "npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "markdownlint-cli": "0.49.1",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "js-yaml": "5.4.2",
    "katex": "0.19.0",
    "markdown-it": "15.0.2",
    "smol-toml": "1.9.0"
  }
}
